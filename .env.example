# Copy to .env, fill in, then: chmod 600 .env
# .env is gitignored. Never commit real keys.
# One pair per paper account alias: ALPACA_<ALIAS>_KEY_ID / ALPACA_<ALIAS>_SECRET_KEY

# Development paper account
ALPACA_DEV_KEY_ID=
ALPACA_DEV_SECRET_KEY=

# Market data: keys from any paper account under the Alpaca login that holds
# Algo Trader Plus (SIP + OPRA). Check with: uv run tournament data-check
ALPACA_DATA_KEY_ID=
ALPACA_DATA_SECRET_KEY=

# Alert bot (Telegram). Create a bot with @BotFather for the token; send it a message, then read
# your chat ID from https://api.telegram.org/bot<TOKEN>/getUpdates. Alerts go to this one chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Control API tokens (two different random strings of at least 32 characters). The owner token
# may control; the viewer token may only read. Make them with:  openssl rand -hex 32
API_OWNER_TOKEN=
API_VIEWER_TOKEN=
