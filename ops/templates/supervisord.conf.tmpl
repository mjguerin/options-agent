; The tournament's own Supervisor (BRD 9.3). A separate instance from Homebrew's, with its own
; socket, so it never loads another program's job file. Rendered by `tournament ops render`
; from config/app/app-v1.yaml; do not edit the rendered copy.

[unix_http_server]
file=__RUN__/supervisor.sock
chmod=0700

[supervisord]
logfile=__LOGS__/supervisord.log
logfile_maxbytes=20MB
logfile_backups=5
pidfile=__RUN__/supervisord.pid
childlogdir=__LOGS__
nodaemon=true

[rpcinterface:supervisor]
supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface

[supervisorctl]
serverurl=unix://__RUN__/supervisor.sock

; The alert bot runs all day, apart from the engine, so it can report an engine that is not
; running (AG-09). It needs TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID in .env.
[program:alerts]
command=__UV__ run --project __REPO__ tournament alerts run
directory=__REPO__
autostart=true
autorestart=true
startsecs=10
startretries=10
stopsignal=TERM
stopwaitsecs=15
redirect_stderr=true
stdout_logfile=__LOGS__/alerts.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
environment=HOME="__HOME__",PATH="/opt/homebrew/bin:/usr/bin:/bin"

; The control API, on a loopback address only (NFR-14). A restart of this program never touches
; the engine: it only reads state and queues commands. Needs API_OWNER_TOKEN and API_VIEWER_TOKEN.
[program:api]
command=__UV__ run --project __REPO__ tournament api run
directory=__REPO__
autostart=true
autorestart=true
startsecs=10
startretries=10
stopsignal=TERM
stopwaitsecs=15
redirect_stderr=true
stdout_logfile=__LOGS__/api.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
environment=HOME="__HOME__",PATH="/opt/homebrew/bin:/usr/bin:/bin"

; Started by launchd at the pre-market time, not at boot, so an automatic restart can never load
; code that is being edited in the evening. Exit 0 is a normal day or a deliberate skip; exit 3 is
; a failed preflight (restarting would not fix it).
[program:engine]
command=__UV__ run --project __REPO__ tournament engine daily
directory=__REPO__
autostart=false
autorestart=unexpected
exitcodes=0,3
startsecs=__STARTSECS__
startretries=__RETRIES__
stopsignal=INT
stopwaitsecs=__STOPWAIT__
stopasgroup=true
killasgroup=true
redirect_stderr=true
stdout_logfile=__LOGS__/engine.log
stdout_logfile_maxbytes=50MB
stdout_logfile_backups=10
environment=HOME="__HOME__",PATH="/opt/homebrew/bin:/usr/bin:/bin"
