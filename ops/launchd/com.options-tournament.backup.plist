<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly local pg_dump (NFR-09). Runs at boot-level
     so it doesn't depend on a login. __USER__/__REPO__/__HOME__ are filled in
     by setup_host.sh. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.options-tournament.backup</string>
	<key>UserName</key>
	<string>__USER__</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__REPO__/ops/backup/pg_backup.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>20</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/options-tournament/backup.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/options-tournament/backup.log</string>
</dict>
</plist>
